# Copy to server/.env for local development. Never commit the real .env.
# Local PostgreSQL 15 runs on port 5433 (port 5432 belongs to a separate EDB Postgres 17 install).
ENV=development
DATABASE_URL=postgresql+psycopg://postgres:<your-password>@localhost:5433/kinlan_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-secret>
CORS_ORIGINS=["http://localhost:8081"]
EXPO_ACCESS_TOKEN=
